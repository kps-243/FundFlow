# Copier ce fichier en .env et remplir les valeurs.
# cp .env.example .env

# ── GlitchTip ──────────────────────────────────────────────────────────────
# Récupérer le DSN depuis : http://glitchtip.localhost → Settings → DSN
# (ou https://app.glitchtip.com si vous utilisez le cloud)
NUXT_PUBLIC_GLITCHTIP_DSN=http://<public_key>@glitchtip.localhost/1
GLITCHTIP_SECRET_KEY=change_me_at_least_32_chars_long!
GLITCHTIP_DOMAIN=http://glitchtip.localhost
GLITCHTIP_DB_NAME=glitchtip
GLITCHTIP_DB_USER=glitchtip
GLITCHTIP_DB_PASS=glitchtip_secret
EMAIL_URL=consolemail://

# ── Umami ──────────────────────────────────────────────────────────────────
# 1. Démarrer Umami : docker compose up umami umami-db -d
# 2. Ouvrir http://umami.localhost → login admin/umami
# 3. Settings → Websites → Add website → copier le Website ID (UUID)
NUXT_PUBLIC_UMAMI_WEBSITE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
NUXT_PUBLIC_UMAMI_URL=http://umami.localhost
UMAMI_APP_SECRET=change_me_at_least_32_chars_long!
UMAMI_DB_NAME=umami
UMAMI_DB_USER=umami
UMAMI_DB_PASS=umami_secret
